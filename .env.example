# CyberShield Awareness - Environment Configuration Template

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (MySQL / SQLite compatible Drizzle connection)
DATABASE_URL="mysql://root:@127.0.0.1:3306/cybercrime_awareness"

# Security & Secrets
JWT_SECRET="replace-with-secure-random-jwt-secret-key-at-least-32-chars"
ENCRYPTION_KEY="replace-with-base64-32-byte-aes-encryption-key"

# OAuth Configuration (Optional / External)
OAUTH_CLIENT_ID="your-client-id"
OAUTH_CLIENT_SECRET="your-client-secret"
OAUTH_REDIRECT_URI="http://localhost:5173/api/oauth/callback"
